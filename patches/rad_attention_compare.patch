index 0000000..9c8e9e1
--- /dev/null
+++ b/proposition/visualization/export_rad_attention.py
@@ -0,0 +1,253 @@
+"""Export test-set cross-attention of a trained *original* RAD checkpoint.
+
+This script is read-only with respect to RAD: it imports RAD classes and
+functions unchanged, loads ``checkpoints/best.pt`` from a finished ``main_rad.py``
+run, and replays the exact RAD test forward pass (``engine.train_rad.valid_on_ICD``)
+with ``return_atten=True`` on both decoders. Nothing is trained.
+
+What RAD's attention is (documented in the output schema):
+- the cross-attention of the LAST of the 4 decoder layers, averaged over its 4 heads,
+  shape (N, C, L) where L = image patches + caption tokens;
+- caption PAD tokens are NOT masked by RAD, so part of the mass may fall on PAD;
+- RAD reads the 16-token query slab in batch-position order: sample at batch
+  position b uses query token (b mod 16). The batch size must therefore equal the
+  ``test_batch_size`` of the RAD run; the token position is stored per sample.
+
+The script checks that the replayed probabilities equal ``predictions/test_best.npz``
+written by RAD; if they do not, it stops rather than export a different model.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import torch
+import yaml
+from torch.utils.data import DataLoader, SequentialSampler
+from transformers import AutoTokenizer
+
+from dataset.test_dataset import Skin_Test_Dataset
+from engine.train_rad import get_text_features_bert
+from models.clip_tqn import ModelRes, TQN_Model_fusion, Text_Encoder_Bert
+
+# Constants copied from engine/train_rad.py::valid_on_ICD for the skin dataset.
+LABEL_SEQUENCE_LENGTH = 16
+GUIDELINE_SEQUENCE_LENGTH = 16
+TEXT_SEQUENCE_LENGTH = 512
+BRANCHES = ("guideline", "label")
+
+
+def _labels(csv_path: str) -> list[str]:
+    return list(pd.read_csv(csv_path, nrows=0).columns[2:])
+
+
+def _guidelines(path: str, labels: list[str]) -> list[str]:
+    texts: list[str] = []
+    with open(path, "r", encoding="utf-8") as handle:
+        for index, line in enumerate(handle):
+            record = json.loads(line)
+            if record["query"] != labels[index]:
+                raise RuntimeError(f"guideline {index} ({record['query']!r}) does not match label {labels[index]!r}")
+            texts.append(record["guideline_1_content"])
+    if len(texts) != len(labels):
+        raise RuntimeError("guideline count does not match label count")
+    return texts
+
+
+def _entropy(attention: torch.Tensor) -> torch.Tensor:
+    safe = attention.clamp_min(torch.finfo(attention.dtype).tiny)
+    return -(safe * safe.log()).sum(-1) / float(np.log(attention.shape[-1]))
+
+
+def _image_paths(dataset: Any) -> list[str]:
+    root = Path(dataset.image_root) if getattr(dataset, "image_root", None) else None
+    return [
+        str(Path(str(p)) if Path(str(p)).is_absolute() or root is None else root / str(p))
+        for p in dataset.img_path_list
+    ]
+
+
+@torch.no_grad()
+def export(args: argparse.Namespace) -> Path:
+    run_dir = Path(args.rad_run_dir)
+    device = torch.device(args.device)
+    config = yaml.safe_load(Path(args.rad_config).read_text(encoding="utf-8"))
+    batch_size = int(args.batch_size or config["test_batch_size"])
+
+    labels = _labels(args.test_csv)
+    guideline_texts = _guidelines(args.guideline_path, labels)
+    tokenizer = AutoTokenizer.from_pretrained(args.bert_model_name, do_lower_case=True)
+
+    image_encoder = ModelRes(res_base_model=args.image_encoder_name, embed_dim=args.embed_dim).to(device)
+    text_encoder = Text_Encoder_Bert(bert_model_name=args.bert_model_name, embed_dim=args.embed_dim).to(device)
+    model = TQN_Model_fusion(embed_dim=args.embed_dim).to(device)
+    model_guideline = TQN_Model_fusion(embed_dim=args.embed_dim).to(device)
+    state = torch.load(run_dir / "checkpoints" / "best.pt", map_location="cpu", weights_only=False)
+    model.load_state_dict(state["model"])
+    model_guideline.load_state_dict(state["model_guideline"])
+    image_encoder.load_state_dict(state["image_encoder"])
+    text_encoder.load_state_dict(state["text_encoder"])
+    for module in (model, model_guideline, image_encoder, text_encoder):
+        module.eval()
+
+    dataset = Skin_Test_Dataset(args.test_csv, config["image_res"], args.image_root)
+    loader = DataLoader(dataset, batch_size=batch_size, sampler=SequentialSampler(dataset),
+                        num_workers=int(config.get("test_num_workers", 0)), drop_last=False)
+
+    # Static queries, computed once exactly as in valid_on_ICD.
+    _, label_hidden = get_text_features_bert(text_encoder, labels, tokenizer, device, max_length=args.max_length)
+    _, guideline_hidden = get_text_features_bert(text_encoder, guideline_texts, tokenizer, device, max_length=args.max_length)
+    queries = {
+        "label": (model, label_hidden[:, :LABEL_SEQUENCE_LENGTH, :]),
+        "guideline": (model_guideline, guideline_hidden[:, :GUIDELINE_SEQUENCE_LENGTH, :]),
+    }
+
+    full_indices = np.asarray([], dtype=np.int64)
+    if args.proposition_evidence:
+        with np.load(args.proposition_evidence) as values:
+            full_indices = values["full_attention_sample_indices"].astype(np.int64)
+    full_set = set(full_indices.tolist())
+
+    collected: dict[str, list[np.ndarray]] = {"gt": [], "caption_input_ids": [], "caption_attention_mask": [],
+                                              "query_token_position": []}
+    for branch in BRANCHES:
+        for key in ("pred", "top_indices", "top_weights", "entropy", "image_mass", "caption_mass", "pad_mass"):
+            collected[f"{branch}_{key}"] = []
+    full_attention = {branch: [] for branch in BRANCHES}
+    image_token_count = None
+    offset = 0
+
+    for sample in loader:
+        image = sample["image"].to(device, non_blocking=True)
+        gt = sample["label"].float()
+        image_features, _ = image_encoder(image)
+        tokens = tokenizer(list(sample["entity"]), add_special_tokens=True, padding="max_length",
+                           truncation=True, max_length=args.max_length, return_tensors="pt").to(device)
+        _, text_hidden = text_encoder.encode_text(tokens)
+        fusion = torch.cat((image_features, text_hidden[:, :TEXT_SEQUENCE_LENGTH, :]), dim=1)
+        n_img = image_features.shape[1]
+        image_token_count = n_img
+        caption_mask = tokens["attention_mask"][:, :TEXT_SEQUENCE_LENGTH].bool()
+        current = image.shape[0]
+
+        for branch, (decoder, query) in queries.items():
+            logits, attention = decoder(query, fusion, return_atten=True)
+            attention = attention.float()  # (B, C, L): last layer, head-averaged
+            probabilities = torch.sigmoid(logits)[:, :, 0]
+            k = min(args.attention_topk, attention.shape[-1])
+            top_w, top_i = torch.topk(attention, k=k, dim=-1)
+            image_mass = attention[..., :n_img].sum(-1)
+            caption_part = attention[..., n_img:]
+            caption_mass = (caption_part * caption_mask[:, None, :]).sum(-1)
+            collected[f"{branch}_pred"].append(probabilities.cpu().numpy())
+            collected[f"{branch}_top_indices"].append(top_i.to(torch.int32).cpu().numpy())
+            collected[f"{branch}_top_weights"].append(top_w.cpu().numpy())
+            collected[f"{branch}_entropy"].append(_entropy(attention).cpu().numpy())
+            collected[f"{branch}_image_mass"].append(image_mass.cpu().numpy())
+            collected[f"{branch}_caption_mass"].append(caption_mass.cpu().numpy())
+            collected[f"{branch}_pad_mass"].append((1.0 - image_mass - caption_mass).cpu().numpy())
+            for local in range(current):
+                if offset + local in full_set:
+                    full_attention[branch].append(attention[local].to(torch.float16).cpu().numpy())
+
+        collected["gt"].append(gt.numpy())
+        collected["caption_input_ids"].append(tokens["input_ids"].cpu().numpy())
+        collected["caption_attention_mask"].append(tokens["attention_mask"].to(torch.int8).cpu().numpy())
+        collected["query_token_position"].append(
+            (np.arange(current) % LABEL_SEQUENCE_LENGTH).astype(np.int16))
+        offset += current
+
+    arrays = {key: np.concatenate(value, axis=0) for key, value in collected.items()}
+
+    # Replay check against the predictions RAD saved after its own test pass.
+    saved_path = run_dir / "predictions" / "test_best.npz"
+    if saved_path.is_file():
+        with np.load(saved_path) as saved:
+            for branch, saved_key in (("label", "pred_label"), ("guideline", "pred_guideline")):
+                difference = float(np.abs(saved[saved_key] - arrays[f"{branch}_pred"]).max())
+                if difference > args.replay_tolerance:
+                    raise RuntimeError(
+                        f"replayed {branch} probabilities differ from {saved_path} by {difference:.2e}; "
+                        "check checkpoint, config, test CSV and batch size"
+                    )
+            replay_note = f"matched {saved_path.name} within {args.replay_tolerance}"
+    else:
+        replay_note = "predictions/test_best.npz not found; replay not verified"
+
+    final_metrics_path = run_dir / "final_metrics.json"
+    if final_metrics_path.is_file():
+        weights = np.asarray(json.loads(final_metrics_path.read_text(encoding="utf-8"))["fusion_weights"], dtype=np.float32)
+        arrays["fused_pred"] = arrays["label_pred"] * weights[None, :] + arrays["guideline_pred"] * (1 - weights[None, :])
+        arrays["fusion_weights"] = weights
+
+    present = sorted(full_set)
+    arrays["full_attention_sample_indices"] = np.asarray([i for i in present if i < offset], dtype=np.int64)
+    for branch in BRANCHES:
+        arrays[f"{branch}_full_attention"] = (
+            np.stack(full_attention[branch]) if full_attention[branch] else np.zeros((0, 0, 0), np.float16)
+        )
+    arrays["image_token_count"] = np.full(offset, image_token_count, dtype=np.int32)
+    arrays["image_paths"] = np.asarray(_image_paths(dataset), dtype=str)
+
+    output_dir = Path(args.output_dir or run_dir / "checklist")
+    output_dir.mkdir(parents=True, exist_ok=True)
+    output = output_dir / "rad_attention_evidence.npz"
+    temporary = output.with_suffix(".tmp.npz")
+    np.savez_compressed(temporary, **arrays)
+    os.replace(temporary, output)
+
+    schema = {
+        "artifact": output.name,
+        "model": "original RAD (main_rad.py), unchanged",
+        "attention_definition": "cross-attention of the last decoder layer, averaged over 4 heads",
+        "branches": list(BRANCHES),
+        "query_count": len(labels),
+        "disease_ids": labels,
+        "memory_layout": {"image": [0, image_token_count],
+                          "caption": [image_token_count, image_token_count + TEXT_SEQUENCE_LENGTH]},
+        "caption_pad_masked": False,
+        "query_token_position": "RAD query token used for each sample = batch position mod 16",
+        "test_batch_size": batch_size,
+        "replay_check": replay_note,
+        "fields": {
+            "{branch}_pred": "sigmoid probability per disease (N, C)",
+            "{branch}_top_indices / _top_weights": "top memory positions per disease query (N, C, K)",
+            "{branch}_entropy": "normalized attention entropy over all L positions (N, C)",
+            "{branch}_image_mass / _caption_mass / _pad_mass": "attention mass on image patches, real caption tokens, caption PAD (N, C)",
+            "{branch}_full_attention": "full attention for full_attention_sample_indices (K, C, L), float16",
+            "fused_pred": "RAD fused probability using fusion_weights from final_metrics.json (N, C)",
+        },
+    }
+    output.with_suffix(".schema.json").write_text(json.dumps(schema, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(f"RAD attention exported to {output} ({replay_note})")
+    return output
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rad_run_dir", required=True, help="finished main_rad.py output directory")
+    parser.add_argument("--rad_config", required=True, help="the YAML config used by that RAD run")
+    parser.add_argument("--test_csv", required=True)
+    parser.add_argument("--image_root", required=True)
+    parser.add_argument("--bert_model_name", required=True)
+    parser.add_argument("--guideline_path", default="guideline/qwen_maxtoken2k_skincap47_4sources.jsonl")
+    parser.add_argument("--proposition_evidence", help="test_proposition_evidence.npz; reuses its full-attention samples")
+    parser.add_argument("--output_dir", help="default: <rad_run_dir>/checklist")
+    parser.add_argument("--batch_size", type=int, help="default: test_batch_size of the RAD config")
+    parser.add_argument("--image_encoder_name", default="resnet50")
+    parser.add_argument("--embed_dim", type=int, default=768)
+    parser.add_argument("--max_length", type=int, default=512)
+    parser.add_argument("--attention_topk", type=int, default=10)
+    parser.add_argument("--replay_tolerance", type=float, default=1e-4)
+    parser.add_argument("--device", default="cuda")
+    return parser
+
+
+if __name__ == "__main__":
+    export(build_parser().parse_args())
