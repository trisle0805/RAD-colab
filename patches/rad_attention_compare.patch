+++ b/proposition/visualization/compare_attention.py
@@ -0,0 +1,198 @@
+"""Compare attention of original RAD and the proposition model on the same test cases.
+
+Inputs are saved artifacts only (no model is loaded):
+- ``test_proposition_evidence.npz`` (+ ``proposition_index.json``, ``disease_index.json``)
+  written by ``main_proposition.py``;
+- ``rad_attention_evidence.npz`` written by ``export_rad_attention.py``.
+
+Outputs (default ``<proposition checklist dir>/attention_comparison/``):
+- ``attention_comparison.json``: summary statistics for RAD guideline, RAD label and the
+  proposition model, computed on the query of each sample's TRUE disease;
+- ``sample_XXXX/report.html``: side-by-side image heatmaps and caption highlighting for
+  the true disease, for every test case whose full attention was stored by both models.
+
+The proposition model has one query per proposition; its disease-level map is the
+uniform mean of the attention of that disease's propositions, mirroring the uniform
+mean used to build the disease score.
+"""
+
+from __future__ import annotations
+
+import argparse
+import html
+import json
+import math
+import sys
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+from transformers import AutoTokenizer
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import render_attention as ra  # noqa: E402
+
+STREAMS = ("rad_guideline", "rad_label", "proposition")
+
+
+def _edge_positions(n_img: int) -> tuple[set[int], set[int]]:
+    side = math.isqrt(n_img)
+    bottom = set(range(n_img - side, n_img))
+    border = {r * side + c for r in range(side) for c in range(side)
+              if r in (0, side - 1) or c in (0, side - 1)}
+    return bottom, border
+
+
+def _top_shares(top_indices: np.ndarray, caption_mask: np.ndarray, n_img: int) -> dict[str, float]:
+    """Share of top-K positions on image / caption / PAD / bottom image row / image border."""
+
+    bottom, border = _edge_positions(n_img)
+    flat = top_indices.reshape(top_indices.shape[0], -1)
+    total = flat.size
+    is_image = flat < n_img
+    caption_pos = np.clip(flat - n_img, 0, caption_mask.shape[1] - 1)
+    is_real_caption = (~is_image) & (np.take_along_axis(caption_mask, caption_pos, axis=1) > 0)
+    return {
+        "top_k_on_image": float(is_image.sum() / total),
+        "top_k_on_caption": float(is_real_caption.sum() / total),
+        "top_k_on_pad": float(((~is_image) & ~is_real_caption).sum() / total),
+        "top_k_on_bottom_image_row": float(np.isin(flat, list(bottom)).sum() / total),
+        "top_k_on_image_border": float(np.isin(flat, list(border)).sum() / total),
+    }
+
+
+def _masses(attention: np.ndarray, caption_mask: np.ndarray, n_img: int) -> dict[str, float]:
+    """Mean attention mass on image / caption / PAD for full maps (K, L)."""
+
+    image = attention[:, :n_img].sum(-1)
+    caption = (attention[:, n_img:] * caption_mask).sum(-1)
+    return {"mass_image": float(image.mean()), "mass_caption": float(caption.mean()),
+            "mass_pad": float(np.clip(1.0 - image - caption, 0.0, None).mean())}
+
+
+def compare(args: argparse.Namespace) -> Path:
+    prop_path = Path(args.proposition_evidence)
+    checklist = prop_path.parent
+    kb = ra._read_json(checklist / "proposition_index.json")
+    diseases = [d["disease_id"] for d in ra._read_json(checklist / "disease_index.json")]
+    prop_disease = np.asarray([record["disease_index"] for record in kb])
+
+    prop = dict(np.load(prop_path, allow_pickle=False))
+    rad = dict(np.load(args.rad_evidence, allow_pickle=False))
+    if not np.array_equal(prop["image_paths"], rad["image_paths"]):
+        raise ValueError("the two artifacts do not list the same test images in the same order")
+    if not np.array_equal(prop["gt"], rad["gt"]):
+        raise ValueError("the two artifacts have different ground truth")
+
+    n_img = int(prop["image_token_count"][0])
+    caption_mask = prop["caption_attention_mask"].astype(np.float32)
+    truth = prop["gt"].argmax(1)
+    n = truth.shape[0]
+
+    # Summary statistics on the true-disease query of every test case.
+    summary: dict[str, Any] = {"test_cases": int(n), "image_tokens": n_img,
+                               "computed_on": "query of the true disease of each test case"}
+    for branch in ("guideline", "label"):
+        top = rad[f"{branch}_top_indices"][np.arange(n), truth]
+        summary[f"rad_{branch}"] = {
+            "mean_entropy": float(rad[f"{branch}_entropy"][np.arange(n), truth].mean()),
+            "mass_image": float(rad[f"{branch}_image_mass"][np.arange(n), truth].mean()),
+            "mass_caption": float(rad[f"{branch}_caption_mass"][np.arange(n), truth].mean()),
+            "mass_pad": float(rad[f"{branch}_pad_mass"][np.arange(n), truth].mean()),
+            **_top_shares(top, caption_mask, n_img),
+        }
+    prop_rows = [np.where(prop_disease == truth[i])[0] for i in range(n)]
+    entropies = [prop["attention_entropy"][i, rows].mean() for i, rows in enumerate(prop_rows)]
+    # Per-sample shares over all propositions of the true disease, then averaged so every case counts once.
+    per_sample = [_top_shares(prop["attention_top_indices"][i, prop_rows[i]].reshape(1, -1),
+                              caption_mask[i:i + 1], n_img) for i in range(n)]
+    summary["proposition"] = {"mean_entropy": float(np.mean(entropies)),
+                              **{key: float(np.mean([s[key] for s in per_sample])) for key in per_sample[0]}}
+
+    common = sorted(set(prop["full_attention_sample_indices"].tolist())
+                    & set(rad["full_attention_sample_indices"].tolist()))
+    position_prop = {int(s): k for k, s in enumerate(prop["full_attention_sample_indices"])}
+    position_rad = {int(s): k for k, s in enumerate(rad["full_attention_sample_indices"])}
+    if common:
+        full_prop = np.stack([prop["full_attention"][position_prop[s]][prop_disease == truth[s]].astype(np.float32).mean(0)
+                              for s in common])
+        masks_common = caption_mask[common]
+        summary["proposition"].update(_masses(full_prop, masks_common, n_img))
+        summary["full_attention_cases"] = common
+
+    output = Path(args.output_dir or checklist / "attention_comparison")
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "attention_comparison.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")
+
+    tokenizer = AutoTokenizer.from_pretrained(args.bert_model_name, do_lower_case=True)
+    samples = args.samples or common
+    for sample in samples:
+        if sample not in position_prop or sample not in position_rad:
+            raise ValueError(f"sample {sample} has no full attention in both artifacts; choose from {common}")
+        d = int(truth[sample])
+        maps = {
+            "rad_guideline": rad["guideline_full_attention"][position_rad[sample], d].astype(np.float32),
+            "rad_label": rad["label_full_attention"][position_rad[sample], d].astype(np.float32),
+            "proposition": prop["full_attention"][position_prop[sample]][prop_disease == d].astype(np.float32).mean(0),
+        }
+        probabilities = {
+            "rad_guideline": float(rad["guideline_pred"][sample, d]),
+            "rad_label": float(rad["label_pred"][sample, d]),
+            "proposition": float(prop["pred_proposition"][sample, d]),
+        }
+        top1 = {
+            "rad_guideline": diseases[int(rad["guideline_pred"][sample].argmax())],
+            "rad_label": diseases[int(rad["label_pred"][sample].argmax())],
+            "proposition": diseases[int(prop["pred_proposition"][sample].argmax())],
+        }
+        sample_dir = output / f"sample_{sample:04d}"
+        sample_dir.mkdir(parents=True, exist_ok=True)
+        cards = []
+        for stream in STREAMS:
+            attention = maps[stream]
+            image_file = sample_dir / f"{stream}.png"
+            ra._heatmap_overlay(str(prop["image_paths"][sample]), attention[:n_img], image_file, args.alpha)
+            caption_attention = attention[n_img:]
+            tokens = ra._caption_tokens(tokenizer, prop["caption_input_ids"][sample],
+                                        prop["caption_attention_mask"][sample], caption_attention)
+            mass = _masses(attention[None], caption_mask[sample:sample + 1], n_img)
+            note = ""
+            if stream.startswith("rad"):
+                note = f"<br><b>RAD query token position:</b> {int(rad['query_token_position'][sample])}"
+            else:
+                note = f"<br><b>Mean of {int((prop_disease == d).sum())} proposition maps</b>"
+            cards.append(f"""
+            <article class="card"><h3>{stream}</h3>
+              <p><b>P({html.escape(diseases[d])})</b> = {probabilities[stream]:.4f}; <b>top-1:</b> {html.escape(top1[stream])}
+              <br><b>attention mass</b> image {mass['mass_image']:.2f} · caption {mass['mass_caption']:.2f} · PAD {mass['mass_pad']:.2f}{note}</p>
+              <img src="{image_file.name}" alt="{stream} image attention">
+              <p class="caption">{ra._caption_html(tokens)}</p>
+            </article>""")
+        (sample_dir / "report.html").write_text(f"""<!doctype html><html><head><meta charset="utf-8">
+<title>Attention comparison {sample}</title><style>
+body {{ font-family: Arial, sans-serif; margin: 24px; color: #1f2937; }}
+.card {{ display:inline-block; vertical-align:top; width:32%; min-width:320px; margin:0 1% 16px 0; padding:12px;
+        box-sizing:border-box; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc; }}
+.card img {{ width:100%; border-radius:5px; }} .caption {{ line-height:2.1; background:white; padding:8px; }}
+</style></head><body>
+<h1>Sample {sample} — true disease: {html.escape(diseases[d])}</h1>
+<p>Image heatmaps and caption colours are min–max normalized within each map; compare the printed attention masses for absolute values.</p>
+{''.join(cards)}
+</body></html>""", encoding="utf-8")
+    print(f"Attention comparison written to {output}")
+    return output
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--proposition_evidence", required=True, type=Path)
+    parser.add_argument("--rad_evidence", required=True, type=Path)
+    parser.add_argument("--bert_model_name", required=True)
+    parser.add_argument("--output_dir", type=Path)
+    parser.add_argument("--samples", nargs="+", type=int)
+    parser.add_argument("--alpha", type=float, default=0.45)
+    return parser
+
+
+if __name__ == "__main__":
+    compare(build_parser().parse_args())
